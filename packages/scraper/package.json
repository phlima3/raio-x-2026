{
  "name": "@raiox/scraper",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sync": "tsx src/index.ts",
    "sync:camara": "tsx src/sources/camara.ts",
    "sync:senado": "tsx src/sources/senado.ts",
    "sync:tse": "tsx src/sources/tse.ts",
    "sync:tse:photos": "tsx src/jobs/syncTseCandidatePhotos.ts",
    "sync:tse:priority": "tsx src/jobs/syncTsePriorityOffices.ts",
    "sync:tse:supplemental": "tsx src/sources/tseSupplemental.ts",
    "bios:tse": "tsx src/jobs/importTseRegistryBios.ts",
    "sync:documents": "tsx src/sources/tseDocuments.ts",
    "sync:divulgacand": "tsx src/sources/tseDivulgaCand.ts",
    "sync:financiamento": "tsx src/sources/tseFinanciamento.ts",
    "import:contas": "tsx src/jobs/importTseAccounting.ts",
    "sync:sites": "tsx src/jobs/weeklyProposals.ts",
    "sync:all": "tsx src/jobs/dailySync.ts",
    "sync:presidenciaveis": "tsx src/jobs/syncPresidenciaveis.ts",
    "process:proposals": "tsx src/jobs/weeklyProposals.ts",
    "extract:programs": "tsx src/jobs/extractProgramProposals.ts",
    "publish:programs": "tsx src/jobs/publishProgramProposals.ts",
    "populate": "tsx src/jobs/populateRealData.ts",
    "populate:senado": "tsx src/jobs/populateRealData.ts senado",
    "populate:sites": "tsx src/jobs/populateRealData.ts sites",
    "import:gemini": "tsx src/scripts/importGeminiData.ts",
    "import:gemini:dry": "tsx src/scripts/importGeminiData.ts -- --dry-run",
    "news:weekly": "tsx src/jobs/weeklyNews.ts",
    "import:tse": "tsx src/jobs/importTseHistorico.ts",
    "import:financiamento": "tsx src/jobs/importTseFinanciamento.ts",
    "backfill:persons": "tsx src/jobs/backfillPersons.ts",
    "review:report": "tsx src/jobs/reviewItemsReport.ts",
    "prisma:generate": "prisma generate --schema=../api/prisma/schema.prisma"
  },
  "dependencies": {
    "@google/generative-ai": "^0.14.1",
    "@prisma/client": "^5.14.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.2",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "fflate": "^0.8.3",
    "groq-sdk": "^1.1.2",
    "ioredis": "^5.10.1",
    "iconv-lite": "^0.7.3",
    "node-cron": "^3.0.3",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.44.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "@types/adm-zip": "^0.5.7",
    "prisma": "^5.14.0",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5"
  }
