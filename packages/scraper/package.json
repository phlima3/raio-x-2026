{
  "name": "@raiox/scraper",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "tsx --test src/**/*.test.ts",
    "sync": "tsx src/index.ts",
    "sync:camara": "tsx src/sources/camara.ts",
    "sync:senado": "tsx src/sources/senado.ts",
    "sync:tse": "tsx src/sources/tse.ts",
    "sync:sites": "tsx src/sources/candidateSites.ts",
    "sync:all": "tsx src/jobs/dailySync.ts",
    "sync:presidenciaveis": "tsx src/jobs/syncPresidenciaveis.ts",
    "process:proposals": "tsx src/jobs/weeklyProposals.ts",
    "populate": "tsx src/jobs/populateRealData.ts",
    "populate:senado": "tsx src/jobs/populateRealData.ts senado",
    "populate:sites": "tsx src/jobs/populateRealData.ts sites",
    "import:gemini": "tsx src/scripts/importGeminiData.ts",
    "import:gemini:dry": "tsx src/scripts/importGeminiData.ts -- --dry-run",
    "news:weekly": "tsx src/jobs/weeklyNews.ts",
    "import:tse": "tsx src/jobs/importTseHistorico.ts",
    "import:financiamento": "tsx src/jobs/importTseFinanciamento.ts",
    "prisma:generate": "prisma generate --schema=../api/prisma/schema.prisma"
  },
  "dependencies": {
    "@google/generative-ai": "^0.14.1",
    "@prisma/client": "^5.14.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "groq-sdk": "^1.1.2",
    "ioredis": "^5.10.1",
    "node-cron": "^3.0.3",
    "playwright": "^1.44.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "@types/adm-zip": "^0.5.7",
    "prisma": "^5.14.0",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5"
  }
}
