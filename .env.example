# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/raiox2026"
REDIS_URL="redis://localhost:6379"
# ── AI / Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"

# ── Government APIs ───────────────────────────────────────────────────────────
TSE_API_URL="https://dadosabertos.tse.jus.br/api"
# Opcional: sobrescreve o ZIP oficial diário usado pelo sync de candidaturas.
TSE_CANDIDATES_ZIP_URL="https://cdn.tse.jus.br/estatistica/sead/odsele/consulta_cand/consulta_cand_2026.zip"
TSE_CANDIDATES_COMPLEMENT_ZIP_URL="https://cdn.tse.jus.br/estatistica/sead/odsele/consulta_cand_complementar/consulta_cand_complementar_2026.zip"
# Consulta pública por candidatura (propostas, sites e e-mails de um candidato
# por vez). O `idEleicao` sai da URL divulgada pelo TSE:
# https://divulgacandcontas.tse.jus.br/divulga/#/candidato/BR/BR/20322002026
TSE_DIVULGACAND_URL="https://divulgacandcontas.tse.jus.br"
TSE_DIVULGACAND_ELECTION_ID="20322002026"
CAMARA_API_URL="https://dadosabertos.camara.leg.br/api/v2"
SENADO_API_URL="https://legis.senado.leg.br/dadosabertos"

# ── API Server ────────────────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL="http://localhost:3001"
CANDIDATE_READ_MODEL="legacy"

# ── Web ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_URL_INTERNAL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# Revalidação ISR: use o mesmo segredo no frontend e no scraper.
REVALIDATION_SECRET="replace-with-a-long-random-secret"
WEB_REVALIDATION_URL="http://localhost:3000/api/revalidate"

# SEO/analytics (opcionais até as propriedades externas serem configuradas)
GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_WEB_VITALS_ENDPOINT="/api/web-vitals"

# Origens usadas pelos comandos de auditoria (sobrescreva para staging/local)
SEO_SITE_ORIGIN="https://raio-x-2026.com.br"
SEO_API_ORIGIN="https://api.raio-x-2026.com.br"

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Scraper ───────────────────────────────────────────────────────────────────
SCRAPER_HEADLESS=true
SCRAPER_CONCURRENCY=3
