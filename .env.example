# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/raiox2026"
REDIS_URL="redis://localhost:6379"
# ── AI / Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"

# ── Government APIs ───────────────────────────────────────────────────────────
TSE_API_URL="https://dadosabertos.tse.jus.br/api"
CAMARA_API_URL="https://dadosabertos.camara.leg.br/api/v2"
SENADO_API_URL="https://legis.senado.leg.br/dadosabertos"

# ── API Server ────────────────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL="http://localhost:3001"

# ── Web ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── Analytics (Umami) ─────────────────────────────────────────────────────────
# Deixe em branco para desativar. O script só é injetado quando ambos estão definidos.
# Self-hosted na Veloz: use a URL do serviço umami + website ID do dashboard.
# Umami Cloud: script url = https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
NEXT_PUBLIC_UMAMI_SCRIPT_URL=""

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Scraper ───────────────────────────────────────────────────────────────────
SCRAPER_HEADLESS=true
SCRAPER_CONCURRENCY=3
