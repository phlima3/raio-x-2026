{
  "name": "raio-x-2026",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de transparência eleitoral brasileira - Eleições 2026",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green --kill-others-on-fail \"pnpm --filter @raiox/api dev\" \"pnpm --filter @raiox/web dev\"",
    "dev:api": "pnpm --filter @raiox/api dev",
    "dev:web": "pnpm --filter @raiox/web dev",
    "dev:scraper": "pnpm --filter @raiox/scraper dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @raiox/api db:migrate",
    "db:generate": "pnpm --filter @raiox/api db:generate",
    "db:studio": "pnpm --filter @raiox/api db:studio",
    "scraper:sync": "pnpm --filter @raiox/scraper sync",
    "test": "vitest run",
    "test:unit": "vitest run --exclude **/*.integration.test.ts && pnpm --filter @raiox/api test && pnpm --filter @raiox/scraper test && pnpm --filter @raiox/web test",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "pnpm -r typecheck",
    "clean:processes": "pkill -9 -f 'tsx.*raio-x' 2>/dev/null; pkill -9 -f 'next.*dev' 2>/dev/null; echo 'Done'"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
